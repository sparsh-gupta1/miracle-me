# Copy to .env.demo and fill the three secrets (see DEMO_DEPLOY.md for a one-liner).
DB_PASSWORD=change-me
JWT_SECRET=change-me-long-random
JWT_REFRESH_SECRET=change-me-long-random-2
# 64 hex chars
BANK_ENCRYPTION_KEY=change-me-64-hex
# Every phone number accepts this code. Anyone who can reach the server can log in with it,
# so change it from 1234 if the IP is public. It must be 4 digits (the app has 4 boxes).
DEMO_OTP=1234
# Port exposed on the host
HOST_PORT=4000
