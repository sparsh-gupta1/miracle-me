# Server
PORT=4000
BANK_ENCRYPTION_KEY=your_32_byte_hex_string_here_for_aes256_cbc
NODE_ENV=development

# PostgreSQL Database
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SYNC=true  # Set to true in development to auto-create tables

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=365d

# Logging
LOG_LEVEL=info

#Google API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

#redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# websocket origin
# ALLOWED_ORIGINS=http://localhost:8081


# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_BASE_URL=


FIREBASE_SERVICE_ACCOUNT_PATH=./public/miracle-me-1a3e7-firebase-adminsdk.json
# Inline JSON string of the Firebase service-account key (used by firebase-admin.js).
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key.
# Paste the entire JSON content as a single-line string here.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# cashfree
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2025-01-01

# Agora (audio/video calling)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRATION=3600
AGORA_PRIVILEGE_EXPIRATION=3600
# Secret for the Agora Notification Center Service (NCS) webhook signature.
# Enable NCS in the Agora console, set the callback to POST /api/agora/webhook,
# and paste the signing secret here. Required for the webhook to be accepted.
AGORA_NCS_SECRET=

# Call billing safety net: auto-end a call after this many seconds with no liveness
# activity (Agora join, mute/video toggle, or call-heartbeat). 0 = disabled.
# Only enable once clients send periodic call-heartbeat, or a quiet-but-healthy
# call could be ended early.
AUTO_END_INACTIVITY_SECONDS=0

#message central
MESSAGECENTRAL_AUTH_TOKEN=
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_BASE_URL=
MESSAGECENTRAL_API_KEY= # Base64 encrypted password for Generate Token

# ---------------------------------------------------------------------------
# APNs — Apple Push Notification Service (iOS VoIP / PushKit)
# Required to ring iOS devices when the app is killed/background.
# Get these from: Apple Developer Console → Certificates, IDs & Profiles → Keys
# ---------------------------------------------------------------------------
# Your .p8 private key file path (relative to project root) OR leave blank
# and set APNS_KEY_CONTENT to the raw PEM string for env-only deploys.
APNS_KEY_PATH=./certs/AuthKey_XXXXXXXXXX.p8
# Alternative: paste raw .p8 key content as a single-line string (use \n for newlines)
APNS_KEY_CONTENT=
# 10-character Key ID shown in the Apple Developer portal
APNS_KEY_ID=XXXXXXXXXX
# 10-character Team ID (top right in Apple Developer portal)
APNS_TEAM_ID=XXXXXXXXXX
# Your app's bundle ID (e.g. com.yourcompany.miracleme)
# The VoIP topic will automatically become: <APNS_BUNDLE_ID>.voip
APNS_BUNDLE_ID=com.yourcompany.miracleme
